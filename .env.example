# ── Required ──
BOT_TOKEN=              # from @BotFather
API_ID=                 # from https://my.telegram.org
API_HASH=               # from https://my.telegram.org
OWNER_ID=               # your numeric Telegram user ID

# ── Bot 2: the channel mirror (optional) ──
# A SECOND @BotFather token. Bot 1 sends only what matches your watchlist; bot 2
# sends everything from the same channels EXCEPT what you muted, with link previews
# on so you can see products without opening every link.
# Leave empty to run bot 1 alone — nothing else changes.
# Press Start on bot 2 once: Telegram won't let a bot message you otherwise.
BOT2_TOKEN=
MIRROR_ENABLED=true
MIRROR_MAX_TEXT=700       # characters of the original post kept
MIRROR_SEND_INTERVAL=1.2  # seconds between sends; Telegram 429s a burst
MIRROR_DEDUP_HOURS=24     # both channels post the same item — show it once
MIRROR_REQUIRE_LINK=true  # skip posts with no link (nothing to preview or open)

# Follow amzn.to / fkrt.it links to their destination before deciding whether two
# posts are the same product. This is what makes cross-channel dedup work on the
# shortened links deal channels actually post. One cached request per new link.
RESOLVE_SHORT_LINKS=true
RESOLVE_MAX_URLS=2

# ── Storage ──
# Set this and NDT keeps the watchlist, channels and deal history in Postgres, so
# they survive restarts and redeploys on hosts with no persistent disk.
# Leave empty to use a local SQLite file at DATA_PATH.
#   DATABASE_URL=postgresql://user:password@host:5432/ndt
# Append ?sslmode=require for managed providers that mandate TLS.
# Verify it before deploying:  python check_db.py
DATABASE_URL=

# Postgres pool. Defaults suit serverless providers (Neon, Supabase) that suspend an
# idle database: hold nothing open so it is free to sleep, recycle idle connections
# before the provider kills them, and retry while it wakes back up.
# Raise DB_POOL_MIN_SIZE only on an always-on server where latency matters more.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3
DB_POOL_MAX_IDLE=60
DB_MAX_RETRIES=3

# ── Deployment ──
# Produced by `python generate_session.py`. Required for headless hosts, which have
# no terminal to type the Telegram login code into.
SESSION_STRING=

# SQLite location, and the Telethon session file. On a host with a mounted disk point
# these at it. SESSION_PATH stops mattering once SESSION_STRING is set; DATA_PATH
# stops mattering once DATABASE_URL is set.
DATA_PATH=./data/
SESSION_PATH=./sessions/

# Set by the host. When present, bot.py starts an HTTP server on it (/ and /health).
# PORT=

# Self-ping target so free tiers don't idle the service out.
# Render injects RENDER_EXTERNAL_URL automatically; set KEEPALIVE_URL elsewhere.
# KEEPALIVE_URL=
KEEPALIVE_INTERVAL=600

# ── Matching / scraping ──
# false = rely purely on Telegram link previews, never make outbound HTTP requests.
ENABLE_HTML_SCRAPER=true
PREVIEW_MAX_URLS=2
PREVIEW_RETRIES=4
PREVIEW_RETRY_DELAY=1.5

# ── Channel discovery ──
# /channels lists only joined channels whose name contains one of these substrings
# (plus everything you already track, so you can always untrack it). 'deal' covers
# 'deals', 'sale' covers 'sales'. /searchchannel and /addchannel ignore this.
CHANNEL_NAME_FILTERS=deal,sale

# ── Channel quality report ──
# A digest of which tracked channels are earning their place, from per-channel
# counters (there is no alert history to read). CHANNEL_REPORT_ENABLED=false silences
# the scheduled one; /channelreport still works on demand.
CHANNEL_REPORT_HOURS=8
CHANNEL_REPORT_ENABLED=true
CHANNEL_QUIET_DAYS=7

# ── Retention ──
DEAL_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_HOURS=6
DEDUP_HOURS=24
